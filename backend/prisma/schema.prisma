// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============== ENUMS ==============

enum UserType {
  individual
  company
}

enum UserRole {
  user
  admin
  curator
}

enum KycStatus {
  none
  pending
  verified
}

enum PhoneVerificationStatus {
  none
  pending
  verified
  rejected
}

enum ProductStatus {
  Pending
  In_Review
  Approved
  Rejected
  Sold
}

enum AuthenticityStatus {
  Pending
  Verified
  Rejected
  Under_Review
}

enum ListingCategory {
  normal
  featured
  most_rare
}

enum OrderStatus {
  Pending
  Processing
  Shipped
  Delivered
  Cancelled
}

enum PaymentStatus {
  Pending
  Paid
  Failed
  Refunded
}

enum PaymentMethod {
  online
  cod
}

enum OrderItemStatus {
  Pending
  Shipped
  Delivered
}

enum VendorType {
  SINGLE
  BULK
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AuctionStatus {
  UPCOMING
  ACTIVE
  SOLD
  ENDED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum CartAction {
  ADD
  REMOVE
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// NOTE (#18): Future migration - convert Product.category (String) → enum ProductCategory, Product.condition (String) → enum ProductCondition, ContactMessage.subject (String) → enum ContactSubject, GalleryItem.theme/origin/timePeriod (String) → respective enums
// NOTE (#39): Future migration - standardize enum case to PascalCase: UserType (individual→Individual, company→Company), UserRole (user→User, admin→Admin, curator→Curator), KycStatus, PhoneVerificationStatus, ListingCategory

// ============== MODELS ==============

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password   String?
  supabaseId String?  @unique
  phone      String?  @unique
  phoneVerificationStatus PhoneVerificationStatus @default(none)
  type      UserType @default(individual)
  role      UserRole @default(user)
  kycStatus KycStatus @default(none)
  kycData   Json?    @default("{}")
  banned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  cart      CartItem[]
  wishlist  WishlistItem[]
  orders    Order[]
  vendor    Vendor?
  notifications    Notification[]
  bids             AuctionBid[]
  pushSubscriptions PushSubscription[]
  testimonials     Testimonial[]
  productViews     ProductView[]
  cartEvents       CartEvent[]
  checkoutEvents   CheckoutEvent[]
  auditLogs        AuditLog[]
  ratings          Rating[]
  galleryItems     GalleryItem[]

  @@index([kycStatus])
  @@index([role])
}

model Product {
  id                 String           @id @default(cuid())
  title              String
  category           String
  brand              String?
  listingCategory    ListingCategory  @default(normal)
  description        String
  condition          String
  price              Float
  image              String
  images             String[]
  keywords           String[]
  isVerified         Boolean          @default(false)
  authenticityStatus AuthenticityStatus @default(Pending)

  status             ProductStatus    @default(Pending)
  isPublished        Boolean          @default(false)
  rejectionReason    String?
  reviewedAt         DateTime?
  reviewedBy         String?

  sellerId           String
  seller             User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  auction        Auction?
  productViews   ProductView[]
  cartEvents     CartEvent[]
  checkoutEvents CheckoutEvent[]

  @@index([sellerId])
  @@index([category])
  @@index([isPublished])
  @@index([status])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model GalleryItem {
  id           String   @id @default(cuid())
  title        String
  teaser       String
  description  String
  images       String[]
  origin       String
  timePeriod   String
  institution  String
  significance String
  theme        String
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([theme])
  @@index([createdAt])
}

model Blog {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  excerpt         String
  content         String
  coverImage      String?
  author          String
  authorId        String?
  authorAvatar    String?
  category        String
  tags            String[]
  status          BlogStatus  @default(DRAFT)
  featured        Boolean     @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  readingTime     Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
  @@index([category])
  @@index([featured])
}

model Order {
  id              String        @id @default(cuid())
  displayId       String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          OrderStatus   @default(Pending)
  totalAmount     Float
  shippingAddress String
  city            String
  state           String
  zipCode         String
  phone           String
  trackingID      String?

  paymentStatus   PaymentStatus @default(Pending)
  paymentMethod   PaymentMethod @default(online)
  paymentId       String?       @unique
  paymentOrderId  String?
  paymentSignature String?

  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([displayId])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id         String         @id @default(cuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product        @relation(fields: [productId], references: [id])
  quantity   Int            @default(1)
  price      Float
  status     OrderItemStatus @default(Pending)
  trackingID String?
  createdAt  DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
}

model Vendor {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         VendorType    @default(SINGLE)
  status       VendorStatus  @default(PENDING)
  maxListings  Int           @default(5)
  companyName  String?
  gst          String?
  founderName  String?
  aadhaar      String?
  pan          String?

  aadhaarDoc       String?
  panDoc           String?
  gstDoc           String?
  incorporationDoc String?

  agreementAccepted   Boolean   @default(false)
  agreementSignedAt   DateTime?
  agreementSignedByName String?
  signedAgreementDoc  String?

  pickupAddress     String?
  pickupCity        String?
  pickupState       String?
  pickupZip         String?
  pickupContactName String?
  pickupPhone       String?
  pickupVerified    Boolean  @default(false)
  pickupVerifiedAt  DateTime?
  pickupVerifiedBy  String?

  rating       Float    @default(0)
  ratingCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payouts       Payout[]
  ratings       Rating[]

  @@index([status])
  @@index([type])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action      String
  targetType  String
  targetId    String
  details     String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
}

model Auction {
  id             String        @id @default(cuid())
  title          String
  description    String
  images         String[]
  startingBid    Float
  currentBid     Float?
  reservePrice   Float?
  startDate      DateTime
  endDate        DateTime
  status         AuctionStatus @default(UPCOMING)
  productId      String?       @unique
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  bids           AuctionBid[]

  @@index([status])
  @@index([endDate])
}

model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  createdAt DateTime @default(now())

  @@index([auctionId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Testimonial {
  id         String           @id @default(cuid())
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  content    String
  rating     Int              @default(5)
  images     String[]         @default([])
  status     TestimonialStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status])
}

model ProductView {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

model CartEvent {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    CartAction
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([productId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

model CheckoutEvent {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  @@unique([userId, endpoint])
}

model Payout {
  id          String       @id @default(cuid())
  vendorId    String
  vendor      Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amount      Float
  status      PayoutStatus @default(PENDING)
  periodStart DateTime
  periodEnd   DateTime
  paidAt      DateTime?
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([vendorId])
  @@index([status])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  vendorId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  rating    Int
  createdAt DateTime @default(now())

  @@unique([userId, vendorId])
  @@index([userId])
  @@index([vendorId])
}

