// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password   String?
  supabaseId String?  @unique
  phone      String?  @unique
  type      String   @default("individual") // "individual", "company"
  role      String   @default("user") // "user", "admin", "curator"
  kycStatus String   @default("none") // "none", "pending", "verified"
  kycData   Json?    @default("{}")
  banned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  cart      CartItem[]
  wishlist  WishlistItem[]
  orders    Order[]
  vendor    Vendor?
  notifications Notification[]
  bids           AuctionBid[]
}

model PhoneVerification {
  id        String   @id @default(cuid())
  phone     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Product {
  id                 String   @id @default(cuid())
  title              String
  category           String
  brand              String?
  listingCategory    String   @default("normal") // "normal", "featured", "most_rare"
  description        String
  condition          String
  price              Float
  image              String
  images             String[]
  keywords           String[]
  isVerified         Boolean  @default(false)
  authenticityStatus String   @default("Pending")
  
  // Verification workflow fields
  status             String   @default("Pending") // "Pending", "In Review", "Approved", "Rejected"
  isPublished        Boolean  @default(false) // Only true when status is "Approved"
  rejectionReason    String?  // Reason for rejection (shown to seller)
  reviewedAt         DateTime? // When admin last reviewed
  reviewedBy         String?  // Admin who reviewed (optional for future use)
  
  sellerId           String
  seller             User     @relation(fields: [sellerId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  auction        Auction?
  productViews   ProductView[]
  cartEvents     CartEvent[]
  checkoutEvents CheckoutEvent[]
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model GalleryItem {
  id           String   @id @default(cuid())
  title        String
  teaser       String
  description  String
  images       String[]
  origin       String
  timePeriod   String
  institution  String
  significance String
  theme        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          String      @default("Pending") // "Pending", "Processing", "Shipped", "Delivered", "Cancelled"
  totalAmount     Float
  shippingAddress String
  city            String
  state           String
  zipCode         String
  phone           String
  trackingID      String?     // Delhivery AWB / Tracking ID
  
  // Razorpay payment integration fields
  paymentStatus   String      @default("Pending") // "Pending", "Paid", "Failed", "Refunded"
  paymentId       String?     // Razorpay payment ID
  paymentOrderId  String?     // Razorpay Order ID
  paymentSignature String?    // Razorpay signature
  
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  price     Float    // Price at time of purchase
  createdAt DateTime @default(now())
}

model Vendor {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  type         String   // "SINGLE", "BULK"
  status       String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "SUSPENDED"
  maxListings  Int      @default(5) // 5 for SINGLE, 999999 for BULK
  companyName  String?
  gst          String?
  founderName  String?
  aadhaar      String?
  pan          String?
  
  // Document upload URLs (scanned copies)
  aadhaarDoc       String?
  panDoc           String?
  gstDoc           String?
  incorporationDoc String?
  
  // Seller Agreement digital signature
  agreementAccepted   Boolean   @default(false)
  agreementSignedAt   DateTime?
  agreementSignedByName String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  subscription VendorSubscription?
  payouts       Payout[]
}

model VendorSubscription {
  id               String   @id @default(cuid())
  vendorId         String   @unique
  vendor           Vendor   @relation(fields: [vendorId], references: [id])
  plan             String   // "BULK_MONTHLY", "BULK_YEARLY", "FREE", "CUSTOM_APPROVED"
  status           String   // "active", "cancelled", "expired", "trialing"
  paymentId        String?  // reference to payment/subscription
  currentPeriodEnd DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String   // "APPROVE_KYC", "REJECT_PRODUCT", "SUSPEND_VENDOR", etc.
  targetType  String   // "User", "Product", "Vendor", etc.
  targetId    String
  details     String?
  createdAt   DateTime @default(now())
}

model Auction {
  id             String      @id @default(cuid())
  title          String
  description    String
  images         String[]
  startingBid    Float
  currentBid     Float?
  reservePrice   Float?
  startDate      DateTime
  endDate        DateTime
  status         String      @default("UPCOMING") // "UPCOMING", "ACTIVE", "SOLD", "ENDED"
  productId      String?   @unique
  product        Product?    @relation(fields: [productId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  bids           AuctionBid[]
}

model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Testimonial {
  id         String   @id @default(cuid())
  userId     String?
  authorName String
  content    String
  rating     Int      @default(5) // 1-5 star rating
  status     String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Analytics & Tracking Models

model ProductView {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String?  // null if not logged in
  sessionId String?  // session fingerprint for anonymous users
  createdAt DateTime @default(now())
}

model CartEvent {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  action    String   // "ADD", "REMOVE"
  createdAt DateTime @default(now())
}

model CheckoutEvent {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  orderId   String?  // set when checkout completes
  createdAt DateTime @default(now())
}

model Payout {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  amount      Float
  status      String   @default("PENDING") // "PENDING", "PROCESSING", "PAID", "FAILED"
  periodStart DateTime
  periodEnd   DateTime
  paidAt      DateTime?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

