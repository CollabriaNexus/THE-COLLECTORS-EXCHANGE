{
  "name": "collectors-exchange",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-blogs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "wrangler pages deploy dist --project-name=tce-user",
    "indexnow": "node scripts/indexnow-submit.mjs --sitemap",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node scripts/test-unit.mjs",
    "test:e2e": "npx playwright test --config=tests/playwright.config.js",
    "test:headed": "npx playwright test --config=tests/playwright.config.js --headed",
    "test:ui": "npx playwright test --config=tests/playwright.config.js --ui",
    "test:debug": "npx playwright test --config=tests/playwright.config.js --debug",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.90.17",
    "autoprefixer": "^10.4.23",
    "axios": "^1.13.2",
    "dompurify": "^3.4.11",
    "lucide-react": "^0.562.0",
    "papaparse": "^5.5.3",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.0",
    "vite": "^7.2.4",
    "vitest": "^3.2.6"
  }
}
